# ===== ROTRAC 根 .gitignore（票据 06 扁平化后合并版）=====
# 仓库根 = ROS 2 colcon workspace

# OS 与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python 环境与缓存（.venv 为就地修复的数值环境：pinocchio/nlopt/vendor omnihand SDK）
.venv/
venv/
env/
.conda/
.conda-envs/
.miniconda3/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# colcon workspace 输出（根即 workspace）
/build/
/install/
/log/
/.colcon/

# 数据、生成物、模型、运行日志
*.mcap
*.mcap.*
*.parquet
*.h5
*.hdf5
*.zarr/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
/datasets/
/models/
/artifacts/
/logs/

# runs/ 录制数据不入库（已归档至 ~/backups/ROTRAC-runs-archive/）；仅保留活参数文件
/runs/*
!/runs/retargeting_diag_params.yaml

# 包内运行产物目录
src/**/runs/
*.log
**/.cache/
**/checkpoints/

# 前端
node_modules/
web/dist/

# 本地密钥
.env
.env.*
!.env.example
*.pem
*.key
*.secret
