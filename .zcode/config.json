{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${ZCODE_PROJECT_DIR}/scripts/hooks/doc_write_gate.py\"",
              "timeout": 10,
              "statusMessage": "文档落点门禁"
            }
          ]
        }
      ]
    }
  }
}
